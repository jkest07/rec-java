<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <!-- Información de nuestro proyecto -->
    <groupId>com.recuperacion</groupId>
    <artifactId>rec-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>rec-api</name>

    <description>
        API Java Spring Boot para actividad DevSecOps
    </description>

    <!-- Versión de Java -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Dependencias -->
    <dependencies>

        <!-- Permite crear una API REST con Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Dependencias para pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- Configuración de compilación -->
    <build>

        <plugins>

            <!-- Permite generar y ejecutar la aplicación Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Análisis de vulnerabilidades para Java -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>

                <configuration>
                    <failBuildOnCVSS>7.0</failBuildOnCVSS>

                    <nvdApiKeyEnvironmentVariable>
                        NVD_API_KEY
                    </nvdApiKeyEnvironmentVariable>

                    <nvdMaxRetryCount>10</nvdMaxRetryCount>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>